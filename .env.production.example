# ==============================================================================
# POS SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` on production host: cp .env.production.example .env
# Set secure, generated values before starting Docker Compose.
# ==============================================================================

# 1. Environment & Network
NODE_ENV=production
PORT=4000
APP_DOMAIN=app.pos.bt
TLS_EMAIL=admin@yuevaan.bt
CORS_ORIGIN=https://app.pos.bt

# 2. Production PostgreSQL Database
POSTGRES_USER=pos
# Generate secure database password: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=pos_prod
DATABASE_URL=postgresql://pos:REPLACE_WITH_SECURE_POSTGRES_PASSWORD@postgres:5432/pos_prod?schema=public

# 3. Session & Security
# Generate 32-byte secret: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_CRYPTO_RANDOM_SECRET
SESSION_TTL_HOURS=12
REMEMBER_DEVICE_DAYS=30

# 4. Platform Admin TOTP Encryption Key (Must be 32 bytes base64 encoded)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# 5. Initial Platform Admin Credentials
# Created once on initial seed. Must change password immediately on first login.
PLATFORM_ADMIN_EMAIL=admin@pos.bt
PLATFORM_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_TEMPORARY_ADMIN_PASSWORD

# 6. Safety Flags (STRICTLY FALSE IN PRODUCTION)
# Under no circumstances should demo businesses be seeded on production.
SEED_DEMO_BUSINESSES=false
SEED_DEMO_PASSWORD=

# 7. File Storage
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# 8. Nightly Backup Configuration
BACKUP_RETENTION_DAYS=30
# Optional off-server sync (e.g., s3://bucket/backups or user@remote:/backups)
REMOTE_BACKUP_DESTINATION=

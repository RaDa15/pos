# Application Environment
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://pos:pos_dev_pass@localhost:5432/pos_dev?schema=public

# Session & Security
# Generate with: openssl rand -base64 32
SESSION_SECRET=development_session_secret_replace_in_production_32chars!
SESSION_TTL_HOURS=12
REMEMBER_DEVICE_DAYS=30
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads

# Platform Admin TOTP Encryption (32 bytes base64)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Initial Platform Admin (Used by seed script only)
PLATFORM_ADMIN_EMAIL=admin@pos.bt
PLATFORM_ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin123!

# Demo Data Seeding (Local & Staging only)
SEED_DEMO_BUSINESSES=true
SEED_DEMO_PASSWORD=demo_password_1234

# Frontend API URL
VITE_API_BASE_URL=/api/v1
